
#include <stdio.h>
#include <stdlib.h>

// Structure representing one polynomial term
struct Node {
    int coeff;
    int exp;
    struct Node *next;
};

// Insert a term in descending order of exponent
struct Node *insertTerm(struct Node *head, int coeff, int exp) {
    struct Node *temp = head;
    struct Node *prev = NULL;
    struct Node *newNode;

    // Ignore zero coefficients
    if (coeff == 0)
        return head;

    // Find the correct position
    while (temp != NULL && temp->exp > exp) {
        prev = temp;
        temp = temp->next;
    }

    // Combine terms having the same exponent
    if (temp != NULL && temp->exp == exp) {
        temp->coeff += coeff;
        return head;
    }

    newNode = (struct Node *)malloc(sizeof(struct Node));

    if (newNode == NULL) {
        printf("Memory allocation failed!\n");
        return head;
    }

    newNode->coeff = coeff;
    newNode->exp = exp;
    newNode->next = temp;

    if (prev == NULL)
        head = newNode;
    else
        prev->next = newNode;

    return head;
}

// Read a polynomial from the user
struct Node *createPolynomial() {
    struct Node *head = NULL;
    int n, coeff, exp, i;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Invalid number of terms!\n");
        return NULL;
    }

    for (i = 0; i < n; i++) {
        printf("Enter coefficient and exponent: ");
        scanf("%d%d", &coeff, &exp);

        head = insertTerm(head, coeff, exp);
    }

    return head;
}

// Add two polynomials
struct Node *addPolynomial(struct Node *p1, struct Node *p2) {
    struct Node *result = NULL;

    // Copy all terms from the first polynomial
    while (p1 != NULL) {
        result = insertTerm(result, p1->coeff, p1->exp);
        p1 = p1->next;
    }

    // Add all terms from the second polynomial
    while (p2 != NULL) {
        result = insertTerm(result, p2->coeff, p2->exp);
        p2 = p2->next;
    }

    return result;
}

// Display a polynomial
void display(struct Node *head) {
    struct Node *temp = head;

    if (temp == NULL) {
        printf("0\n");
        return;
    }

    while (temp != NULL) {
        printf("%dx^%d", temp->coeff, temp->exp);

        if (temp->next != NULL)
            printf(" + ");

        temp = temp->next;
    }

    printf("\n");
}

// Free the linked list
void freeList(struct Node *head) {
    struct Node *temp;

    while (head != NULL) {
        temp = head;
        head = head->next;
        free(temp);
    }
}

int main() {
    struct Node *p1, *p2, *sum;

    printf("Enter first polynomial:\n");
    p1 = createPolynomial();

    printf("\nEnter second polynomial:\n");
    p2 = createPolynomial();

    printf("\nFirst polynomial: ");
    display(p1);

    printf("Second polynomial: ");
    display(p2);

    // Calculate the sum
    sum = addPolynomial(p1, p2);

    printf("Sum of polynomials: ");
    display(sum);

    freeList(p1);
    freeList(p2);
    freeList(sum);

    return 0;
}
