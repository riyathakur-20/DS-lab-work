
#include <stdio.h>

int main()
{
    int a[100], n, i, choice, pos, value;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    do {
        printf("\n1. Insert at beginning");
        printf("\n2. Insert at end");
        printf("\n3. Insert at any position");
        printf("\n4. Delete from beginning");
        printf("\n5. Delete from end");
        printf("\n6. Delete from any position");
        printf("\n7. Display array");
        printf("\n8. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (n == 100) {
                    printf("Array is full.\n");
                    break;
                }
                printf("Enter value: ");
                scanf("%d", &value);

                for (i = n; i > 0; i--)
                    a[i] = a[i - 1];

                a[0] = value;
                n++;
                break;

            case 2:
                if (n == 100) {
                    printf("Array is full.\n");
                    break;
                }
                printf("Enter value: ");
                scanf("%d", &value);
                a[n] = value;
                n++;
                break;

            case 3:
                if (n == 100) {
                    printf("Array is full.\n");
                    break;
                }
                printf("Enter value and position: ");
                scanf("%d%d", &value, &pos);

                if (pos < 1 || pos > n + 1) {
                    printf("Invalid position.\n");
                    break;
                }

                for (i = n; i >= pos; i--)
                    a[i] = a[i - 1];

                a[pos - 1] = value;
                n++;
                break;

            case 4:
                if (n == 0) {
                    printf("Array is empty.\n");
                    break;
                }

                for (i = 0; i < n - 1; i++)
                    a[i] = a[i + 1];

                n--;
                break;

            case 5:
                if (n == 0) {
                    printf("Array is empty.\n");
                    break;
                }

                n--;
                break;

            case 6:
                if (n == 0) {
                    printf("Array is empty.\n");
                    break;
                }

                printf("Enter position: ");
                scanf("%d", &pos);

                if (pos < 1 || pos > n) {
                    printf("Invalid position.\n");
                    break;
                }

                for (i = pos - 1; i < n - 1; i++)
                    a[i] = a[i + 1];

                n--;
                break;

            case 7:
                printf("Array elements: ");
                for (i = 0; i < n; i++)
                    printf("%d ", a[i]);
                printf("\n");
                break;

            case 8:
                printf("Program ended.\n");
                break;

            default:
                printf("Invalid choice.\n");
        }
    } while (choice != 8);

    return 0;
}
