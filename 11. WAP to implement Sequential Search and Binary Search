
#include <stdio.h>

// Sequential (linear) search
int linearSearch(int a[], int n, int key) {
    int i;

    for (i = 0; i < n; i++) {
        if (a[i] == key)
            return i;
    }

    return -1;
}

// Binary search on a sorted array
int binarySearch(int a[], int n, int key) {
    int low = 0, high = n - 1, mid;

    while (low <= high) {
        mid = low + (high - low) / 2;

        if (a[mid] == key)
            return mid;
        else if (a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

// Sort the array using bubble sort
void sortArray(int a[], int n) {
    int i, j, temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

int main() {
    int a[100], n, key, i, result;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid array size!\n");
        return 0;
    }

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element to search: ");
    scanf("%d", &key);

    // Perform sequential search on the original array
    result = linearSearch(a, n, key);

    if (result != -1)
        printf("Sequential Search: Found at position %d\n",
               result + 1);
    else
        printf("Sequential Search: Element not found\n");

    // Sort before performing binary search
    sortArray(a, n);

    printf("Sorted array: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");

    result = binarySearch(a, n, key);

    if (result != -1)
        printf("Binary Search: Found at sorted position %d\n",
               result + 1);
    else
        printf("Binary Search: Element not found\n");

    return 0;
}
